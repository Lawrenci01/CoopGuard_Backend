{
  "expo": {
    "name": "CoopGuard",
    "slug": "coopguard",
    "scheme": "coopguard",
    "platforms": ["ios", "android"],
    "version": "0.6.3",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coopguard.app"
    },
    "android": {
      "versionCode": 13,
      "package": "com.coopguard.app",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Allow CoopGuard to scan farm hub and node QR codes." }],
      "./plugins/withLocalTls"
    ]
  }
}
