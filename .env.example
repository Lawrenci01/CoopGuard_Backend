# Local values are shown below. Render supplies PORT automatically and uses
# the values declared in render.yaml.
HOST=0.0.0.0
PORT=8443
CG_DB_PATH=.local/coopguard.sqlite
# Render Free uses these instead of CG_DB_PATH. Keep the token secret.
# TURSO_DATABASE_URL=libsql://your-database-your-account.turso.io
# TURSO_AUTH_TOKEN=your-database-token
CG_HTTPS=true
CG_TRUST_PROXY=false
