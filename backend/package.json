{
  "name": "coopguard-backend",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "provision": "tsx src/provision.ts",
    "provision:telemetry": "tsx src/provisionTelemetry.ts",
    "hub:create": "tsx src/createHub.ts",
    "hub:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-laptop-hub.ps1",
    "hub:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-laptop-hub.ps1",
    "hotspot:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-laptop-hotspot.ps1",
    "hotspot:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-laptop-hotspot.ps1 -Stop",
    "reset-data": "tsx src/purge.ts",
    "reprovision": "tsx src/reprovision.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "tls": "node scripts/create-local-tls.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "@libsql/client": "^0.18.0",
    "@tursodatabase/sync": "^0.8.1",
    "fastify": "5.12.5",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
